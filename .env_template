# For local iframe embedding, put it right here
FRAME_ANCESTORS=https://your-frontend-domain.com
# For another local name, put it here
APP_TITLE="JBG transkribering"
# If you want to make encryption optional
ENCRYPTION_IS_OPTIONAL=1
# Hours before files left in uploads/ and results/ are deleted (at least 3)
JBG_RETENTION_HOURS=24
# Hours before cached transcriptions of unencrypted uploads are deleted (at least 1)
JBG_CACHE_RETENTION_HOURS=24
# Largest upload in MB
JBG_MAX_UPLOAD_MB=1024
